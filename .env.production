# ============================================================
# ============================================================
# G005 放射RIS系统 v3.0.6.11-15 - 生产环境变量
# ============================================================

# AI Provider (mock | deepseek)
VITE_AI_PROVIDER=mock

# DeepSeek — 前端不存储 API Key，由后端代理转发
# VITE_DEEPSEEK_API_KEY 仅用于开发环境 mock，生产使用后端代理
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_VISION_MODEL=deepseek-vl-7b
VITE_DEEPSEEK_STREAM=true
VITE_DEEPSEEK_MAX_TOKENS=2048
VITE_DEEPSEEK_TEMPERATURE=0.3

# API 模式: real → 真实后端 / mock → MSW 拦截
VITE_API_MODE=real

# 后端 API
# v3.0.6.11-21 P0: 后端 NestJS 使用 globalPrefix='api' (见 backend/src/main.ts),
#   大多数 @Controller('xxx') 解析为 /api/xxx,不需要额外的 /v1。
#   部分控制器 hardcode 'api/eye'|'api/v1/olap' 等前缀,属于后端路由命名冗余。
#   与真实部署域名匹配时只需替换 host:port 部分。
VITE_API_BASE_URL=http://localhost:3001/api

# WebRTC 公共信令 (生产应自托管)
VITE_SIGNALING_URLS=wss://signaling.yjs.dev

# Sentry (生产必填)
VITE_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.de.sentry.io/0
VITE_GIT_SHA=

# 应用信息
VITE_APP_NAME=G005 放射RIS
VITE_APP_VERSION=3.0.6.11-31
VITE_BUILD_TIME=2026-07-11

# 部署子路径 (对应 GitHub Pages)
VITE_BASE_PATH=/g005-radiology-ris/

# Release 版本
VITE_RELEASE=3.0.6.11-31

# Analytics 上报端点
VITE_ANALYTICS_ENDPOINT=
