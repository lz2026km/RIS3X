# ============================================================
# ============================================================
# G005 放射RIS系统 v3.0.6.16-1 - 生产环境变量
# ============================================================

# DeepSeek — 前端不存储 API Key，由后端代理转发
# VITE_DEEPSEEK_API_KEY 仅用于开发环境 mock，生产使用后端代理
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_VISION_MODEL=deepseek-vl-7b
VITE_DEEPSEEK_STREAM=true
VITE_DEEPSEEK_MAX_TOKENS=2048
VITE_DEEPSEEK_TEMPERATURE=0.3

# API 模式: real → 真实后端 / mock → MSW 拦截
# [v3.0.6.16-1] 对外演示部署 (GitHub Pages) 必须为 mock:
#   部署站为 HTTPS, 真实后端 http://localhost:3001 会触发混合内容拦截 → 页面全空。
#   若改为真实后端部署, 需将 VITE_API_BASE_URL 换成 HTTPS 域名并改回 real。
VITE_API_MODE=mock

# MSW Mock — 演示站启用 (自带 mock 后端, 无需外部服务)
VITE_USE_MSW=true

# 后端 API
# v3.0.6.11-43: 后端 NestJS 使用 globalPrefix='api' (见 backend/src/main.ts),
#   大多数 @Controller('xxx') 解析为 /api/xxx,不需要额外的 /v1。
#   与真实部署域名匹配时只需替换 host:port 部分。
VITE_API_BASE_URL=http://localhost:3001/api

# CORS — 后端 CORS_ORIGINS 必须配置（生产环境不能为空，否则启动失败）
# 多个 origin 用逗号分隔
CORS_ORIGINS=https://lz2026km.github.io

# WebRTC 公共信令 (生产应自托管)
VITE_SIGNALING_URLS=wss://signaling.yjs.dev

# Sentry (生产必填)
VITE_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.de.sentry.io/0
VITE_GIT_SHA=

# 应用信息
VITE_APP_NAME=G005 放射RIS
VITE_APP_VERSION=3.0.6.16-1
VITE_BUILD_TIME=2026-08-01

# 部署子路径 (对应 GitHub Pages)
VITE_BASE_PATH=/g005-radiology-ris/

# [v3.0.6.16-1] 接口失败时是否回退演示数据
# true = 演示环境友好 (页面永不空白); false = 生产环境如实报错 (防客户拿到假数据)
# 未配置时按 VITE_API_MODE 推断: mock->true, real->false
VITE_ALLOW_DEMO_FALLBACK=false

# Release 版本
VITE_RELEASE=3.0.6.16-1

# Analytics 上报端点
VITE_ANALYTICS_ENDPOINT=
