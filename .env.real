# ============================================================
# G005 放射RIS系统 v3.0.6.16-8 - 真实后端联调版 (mode=real)
# ============================================================
# 用途: 商业演示「完美展现后端功能」的验收产物。
#   与 .env.production (GitHub Pages mock 演示版) 并存, 互不影响:
#     pnpm build            -> mock 演示版 (走浏览器内 MSW, 无需后端)
#     pnpm build:real       -> real 联调版 (走 NestJS 后端, 需先启动 backend)
#
# 启动后端: cd backend && npm run start:dev   (默认 http://localhost:3001)
# 部署到服务器时: 把 VITE_API_BASE_URL 换成同源/HTTPS 域名, 并配置后端 CORS_ORIGINS
# ============================================================

# DeepSeek — 前端不存储 API Key，由后端代理转发
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_VISION_MODEL=deepseek-vl-7b
VITE_DEEPSEEK_STREAM=true
VITE_DEEPSEEK_MAX_TOKENS=2048
VITE_DEEPSEEK_TEMPERATURE=0.3

# API 模式: real → 真实 NestJS 后端
VITE_API_MODE=real

# MSW Mock — 真实模式必须关闭, 否则请求被浏览器内 worker 拦截
VITE_USE_MSW=false

# 后端 API (NestJS globalPrefix='api'; 部署时替换 host:port)
VITE_API_BASE_URL=http://localhost:3001/api

# CORS — 后端 CORS_ORIGINS 必须与前端访问来源一致 (逗号分隔)
CORS_ORIGINS=http://localhost:4173,http://localhost:5191

# WebRTC 公共信令
VITE_SIGNALING_URLS=wss://signaling.yjs.dev

# Sentry
VITE_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.de.sentry.io/0
VITE_GIT_SHA=

# 应用信息
VITE_APP_NAME=G005 放射RIS
VITE_APP_VERSION=3.0.6.16-8
VITE_BUILD_TIME=2026-08-01

# 部署子路径 (real 版按根路径部署; 子路径部署时修改)
VITE_BASE_PATH=/

# 接口失败时是否回退演示数据 — 真实模式必须 false:
#   客户输入不存在的患者号时, 系统应如实报"未找到", 而不是返回假数据
VITE_ALLOW_DEMO_FALLBACK=false

# Release 版本
VITE_RELEASE=3.0.6.16-8

# Analytics 上报端点
VITE_ANALYTICS_ENDPOINT=
