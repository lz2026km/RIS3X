# ============================================================
# G005 放射RIS系统 v3.0.5.0 (R4) - 开发环境变量
# ============================================================

# AI Provider (mock | deepseek)
VITE_AI_PROVIDER=mock

# DeepSeek API Key (演示用，可公开)
# 真实部署应使用后端代理隐藏密钥
VITE_DEEPSEEK_API_KEY=sk-demo-key-replace-with-real-deepseek-key
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_VISION_MODEL=deepseek-vl-7b

# 启用流式响应
VITE_DEEPSEEK_STREAM=true

# 速率限制（演示）
VITE_DEEPSEEK_MAX_TOKENS=2048
VITE_DEEPSEEK_TEMPERATURE=0.3

# v3.0.6.11-21: dev 默认 mock(由 MSW 拦截); 也可设为 'real' 切换
VITE_API_MODE=mock

# 后端 API(仅 VITE_API_MODE=real 时生效; dev 默认走 MSW)
VITE_API_BASE_URL=http://localhost:3001/api
