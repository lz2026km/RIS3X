  @@map("ai_workflow_integrations")
}

// v3.0.6.11-61: 环境式 AI 报告草稿 (生成式草稿 + 医生确认)
// 流程: POST /ai/report-draft 生成 -> 医生 接受/修改 -> 落 reports 表
model AiReportDraft {
  id         String    @id @default(cuid())
  reportId   String    @map("report_id")
  draftText  String    @map("draft_text")
  style      String    @default("standard")
  status     String    @default("PENDING")
  createdBy  String?   @map("created_by")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([reportId])
  @@index([status])
  @@map("ai_report_drafts")
}

model CompressTask {
  id             String    @id @default(cuid())
  instanceUid    String
  originalSize   Int
  compressedSize Int?
  algorithm      String
  ratio          Float?
  status         String    @default("pending")
  progress       Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([instanceUid])
  @@index([status])
  @@map("compress_tasks")
}

model RadiomicsFeature {
  id          String  @id @default(cuid())
  instanceUid String
  roiId       String
  category    String?
  featureName String
  value       Float
  unit        String?
  createdAt   DateTime @default(now())

  @@index([instanceUid])
  @@index([roiId])
  @@map("radiomics_features")
}

model FusionJob {
  id              String   @id @default(cuid())
  primarySeries   String
  secondarySeries String
  type            String
  status          String   @default("completed")
  resultPath      String?
  params          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([primarySeries, secondarySeries])
  @@map("fusion_jobs")
}

model Dicom4dJob {
  id         String   @id @default(cuid())
  seriesUid  String   @unique
  frameCount Int
  status     String   @default("completed")
  resultPath String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("dicom_4d_jobs")
}

model TriageRecord {
  id           String   @id @default(cuid())
  examId       String
  patientId    String
  patientName  String?
  examType     String?
  urgency      Int      @default(0)
  score        Int
  rules        Json?
  status       String   @default("PENDING")
  assignedTo   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([examId])
  @@index([status, score])
  @@map("triage_records")
}

model SmartRouteRule {
  id        String   @id @default(cuid())
  name      String
  priority  Int      @default(0)
  condition Json?
  action    Json?
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
  @@map("smart_route_rules")
}

model WorklistSmartScore {
  id        String   @id @default(cuid())
  examId    String
  score     Float
  weights   Json?
  scoredAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([examId, scoredAt])
  @@map("worklist_smart_scores")
}

// v3.0.6.11-60: 剂量管理 DRL - DoseRecord (RDSR 剂量记录持久化)
model DoseRecord {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  patientId   String?  @map("patient_id")
  patientName String?  @map("patient_name")
  examId      String?  @map("exam_id")
  studyUid    String   @map("study_uid")
  modality    String   @default("CT")
  bodyPart    String   @map("body_part")
  ctdiVol     Float    @map("ctdi_vol")
  dlp         Float
  ssde        Float?
  date        DateTime @map("exam_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([patientId, date])
  @@index([date])
  @@index([modality, date])
  @@index([tenantId])
  @@map("dose_records")
}

// v3.0.6.11-60: Auto-hanging 自动布局 (对标 GE/Siemens/Fujifilm)
// layout Json: { rows, cols, seriesOrder: string[] }
model HangingProtocol {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  modality    String
  bodyPart    String   @map("body_part")
  layout      Json
  priority    Int      @default(0)
  description String   @default("")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([modality, bodyPart])
  @@index([tenantId])
  @@map("hanging_protocols")
}

// v3.0.6.11-60: VNA 厂商中立归档 - 非 DICOM 内容对象 (WORM 不可变归档)
// objectType: document | image; wormLocked 后禁止 delete/覆盖 (对标 Agfa/Sectra/GE Datalogue)
model VnaObject {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  patientId   String?  @map("patient_id")
  studyUid    String?  @map("study_uid")
  objectType  String   @default("document") @map("object_type")
  name        String
  description String?  @map("description")
  mimeType    String   @map("mime_type")
  size        Int      @default(0)
  storagePath String?  @map("storage_path")
  wormLocked  Boolean  @default(false) @map("worm_locked")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([patientId])
  @@index([studyUid])
  @@index([objectType])
  @@index([tenantId])
  @@map("vna_objects")
}

// v3.0.6.11-60: 相似病例检索 - 结果有用性反馈 (对标 Siemens Similar Patient Search)
// reportId: 检索源报告; targetReportId: 返回的相似病例; useful: 医生是否认为结果有用
model SimilarCaseFeedback {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  reportId       String   @map("report_id")
  targetReportId String   @map("target_report_id")
  useful         Boolean
  comment        String?  @default("")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([reportId, targetReportId])
  @@index([tenantId])
  @@index([useful])
  @@map("similar_case_feedbacks")
}

// v3.0.6.11-70: 双人阅片分配 (dual-read) 持久化
// reportId: 关联待分配报告 (assign 从 Report 表检索); reader1Id/reader2Id: 确定性指派的两名阅片医生
// status: pending | reader1_done | reader2_done | both_done | arbitrated
model DualReadAssignment {
  id                String    @id @default(cuid())
  reportId          String?   @map("report_id")
  studyId           String?   @map("study_id")
  patientId         String    @map("patient_id")
  patientName       String    @map("patient_name")
  modality          String
  reader1Id         String    @map("reader1_id")
  reader1Name       String    @map("reader1_name")
  reader2Id         String    @map("reader2_id")
  reader2Name       String    @map("reader2_name")
  report1           String?
  report2           String?
  status            String    @default("pending")
  discrepancyScore  Float?    @map("discrepancy_score")
  arbitrationReport String?   @map("arbitration_report")
  arbitratorId      String?   @map("arbitrator_id")
  arbitratorName    String?   @map("arbitrator_name")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([reportId])
  @@index([patientId])
  @@index([status])
  @@map("dual_read_assignments")
}
