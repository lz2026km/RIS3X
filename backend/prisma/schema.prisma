// G005 放射RIS系统 v3.0.2.2 - Prisma Schema
// v3.0.1:5 个核心 model + 12 枚举
// v3.0.2 增量:CriticalValueNotification / ReportTemplate / ReportAuditEvent
// v3.0.2.2 增量:ReportQualityScore / DicomInstance / Notification
// v3.0.4: 增加 cuid() 默认值、FK 级联、AdverseEvent 枚举、version 乐观锁

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DOCTOR
  TECHNICIAN
  NURSE
  ADMIN
  DIRECTOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ReportState {
  PENDING_ASSIGNMENT
  ASSIGNED
  WRITING
  SUBMITTED
  REVIEWING
  REVIEWED
  SIGNING
  SIGNED
  PUBLISHED
  AMENDING
  AMENDED
  WITHDRAWN
  REJECTED
  ARCHIVED
}

enum DeviceState {
  IDLE
  IN_USE
  MAINTENANCE
  BROKEN
  OFFLINE
}

enum CriticalState {
  FOUND
  NOTIFIED
  ACKNOWLEDGED
  RESOLVING
  RESOLVED
}

enum CriticalSeverity {
  LOW
  HIGH
  URGENT
  CRITICAL
}

enum NotificationMethod {
  PHONE
  SMS
  SYSTEM
  EMAIL
  WECHAT
  DINGTALK
}

enum PatientType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  PHYSICAL
}

enum AppointmentState {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RadsCategory {
  BI_RADS
  LI_RADS
  PI_RADS
  TI_RADS
  CAD_RADS
  C_RADS
  O_RADS
  NI_RADS
}

enum WorklistOpType {
  ASSIGN
  REASSIGN
  START
  COMPLETE
  CANCEL
  PRINT
  EXPORT
}

enum AdverseEventType {
  MEDICATION_ERROR
  PATIENT_IDENTIFICATION
  CONTRAST_REACTION
  RADIATION_OVERDOSE
  FALL
  SPECIMEN_ERROR
  COMMUNICATION_FAILURE
  EQUIPMENT_MALFUNCTION
  INFORMATION_LOSS
  OTHER
}

enum AdverseEventSeverity {
  NEAR_MISS
  MINOR
  MODERATE
  SEVERE
  CATASTROPHIC
}

enum AdverseEventStatus {
  REPORTED
  INVESTIGATING
  RESOLVED
  CLOSED
}

model User {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  username      String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String    @map("full_name")
  role          UserRole
  department    String?
  active              Boolean    @default(true)
  totpSecret          String?    @map("totp_secret")
  totpEnabled         Boolean    @default(false) @map("totp_enabled")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  reports             Report[]   @relation("ReportRadiologist")
  opsLog              WorklistOp[]
  loginLogs           LoginLog[]

  @@index([tenantId])
  @@map("users")
}

model Patient {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  name      String
  gender    Gender
  birthDate DateTime?   @map("birth_date")
  idCard    String?     @unique @map("id_card")
  phone     String?
  type      PatientType @default(OUTPATIENT)
  reports   Report[]
  exams     Exam[]
  studies   EyeStudy[]
  version   Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([name, phone])
  @@index([tenantId])
  @@map("patients")
}

model Exam {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  patientId       String   @map("patient_id")
  accessionNumber String   @unique @map("accession_number")
  modality        String
  bodyPart        String   @map("body_part")
  scheduledAt     DateTime? @map("scheduled_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  deviceId        String?  @map("device_id")
  state           String   @default("SCHEDULED")
  version         Int      @default(0)
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  device          Device?  @relation(fields: [deviceId], references: [id])
  reports         Report[]
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([patientId, modality])
  @@index([tenantId])
  @@map("exams")
}

model Report {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  patientId    String        @map("patient_id")
  examId       String?       @map("exam_id")
  radiologistId String?      @map("radiologist_id")
  state        ReportState   @default(PENDING_ASSIGNMENT)
  findings     String        @default("")
  conclusion   String        @default("")
  signedAt     DateTime?     @map("signed_at")
  isCritical   Boolean       @default(false) @map("is_critical")
  qualityScore Int?          @map("quality_score")
  version      Int           @default(0)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  exam         Exam?         @relation(fields: [examId], references: [id], onDelete: SetNull)
  radiologist  User?         @relation("ReportRadiologist", fields: [radiologistId], references: [id], onDelete: SetNull)
  revisions    ReportRevision[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([state, patientId])
  @@index([tenantId])
  @@map("reports")
}

model ReportRevision {
  id        String      @id @default(cuid())
  reportId  String      @map("report_id")
  actorId   String      @map("actor_id")
  fromState ReportState @map("from_state")
  toState   ReportState @map("to_state")
  reason    String?
  report    Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([reportId, createdAt])
  @@map("report_revisions")
}

model Device {
  id             String      @id @default(cuid())
  tenantId       String      @map("tenant_id")
  code           String      @unique
  name           String
  modality       String
  manufacturer   String?
  location       String?
  state          DeviceState @default(IDLE)
  todayExams     Int         @default(0) @map("today_exams")
  todayUsageMin  Int         @default(0) @map("today_usage_min")
  version        Int         @default(0)
  exams          Exam[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("devices")
}

model CriticalValue {
  id            String             @id @default(cuid())
  examId        String?            @map("exam_id")
  description   String
  severity      CriticalSeverity   @default(HIGH)
  state         CriticalState      @default(FOUND)
  method        NotificationMethod @default(SYSTEM)
  notifiedTo    String?            @map("notified_to")
  ackedBy       String?            @map("acked_by")
  ackedAt       DateTime?          @map("acked_at")
  resolvedBy    String?            @map("resolved_by")
  resolvedAt    DateTime?          @map("resolved_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([state, severity])
  @@map("critical_values")
}

model Appointment {
  id          String           @id @default(cuid())
  patientId   String           @map("patient_id")
  deviceId    String?          @map("device_id")
  modality    String
  scheduledAt DateTime         @map("scheduled_at")
  state       AppointmentState @default(SCHEDULED)
  version     Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([scheduledAt, state])
  @@index([deviceId, scheduledAt])
  @@map("appointments")
}

model RadsTemplate {
  id        String       @id @default(cuid())
  category  RadsCategory
  code      String
  name      String
  body      String
  parentId  String?      @map("parent_id")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([category, code])
  @@map("rads_templates")
}

model WorklistOp {
  id        String         @id @default(cuid())
  actorId   String         @map("actor_id")
  op        WorklistOpType
  examId    String?        @map("exam_id")
  payload   Json?
  actor     User           @relation(fields: [actorId], references: [id])
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@map("worklist_ops")
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ip        String
  userAgent String?  @map("user_agent")
  success   Boolean
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("login_logs")
}

// v3.0.2 新增:CriticalValueNotification / ReportTemplate / ReportAuditEvent
// (Appointment / AppointmentState 在 v3.0.1 已存在,无需重复)

model CriticalValueNotification {
  id            String   @id @default(cuid())
  criticalId    String   @map("critical_id")
  patientName   String   @map("patient_name")
  patientId     String   @map("patient_id")
  category      String
  finding       String
  channel       String
  recipientName String   @map("recipient_name")
  recipientDept String   @map("recipient_dept")
  recipientPhone String  @map("recipient_phone")
  status        String
  ackerName     String?  @map("acker_name")
  ackedAt       DateTime? @map("acked_at")
  escalated     Boolean  @default(false)
  triggeredAt   DateTime @map("triggered_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([criticalId])
  @@index([status, triggeredAt])
  @@map("critical_notifications")
}

model ReportTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String
  bodyPart    String   @map("body_part")
  body        String
  parentId    String?  @map("parent_id")
  version     Int      @default(1)
  radsCategory String? @map("rads_category")
  tags        String[]
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, bodyPart])
  @@map("report_templates")
}

model ReportAuditEvent {
  id           String   @id @default(cuid())
  reportId     String   @map("report_id")
  actor        String
  actorRole    String   @map("actor_role")
  action       String
  description  String
  detail       Json?
  prevHash     String   @map("prev_hash")
  hash         String
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([reportId, createdAt])
  @@map("report_audit_events")
}

// v3.0.2.2 新增:ReportQualityScore + DicomInstance + Notification

model ReportQualityScore {
  id          String   @id @default(cuid())
  reportId    String   @map("report_id")
  totalScore  Int      @map("total_score")
  grade       String
  dimensions  Json
  suggestions String[]
  evaluatedAt DateTime @map("evaluated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([reportId, evaluatedAt])
  @@map("report_quality_scores")
}

model DicomInstance {
  id                String   @id @default(cuid())
  studyInstanceUid  String   @map("study_instance_uid")
  seriesInstanceUid String   @map("series_instance_uid")
  sopInstanceUid    String   @unique @map("sop_instance_uid")
  sopClassUid       String   @map("sop_class_uid")
  modality          String
  storagePath       String?  @map("storage_path")
  sizeBytes         Int?     @map("size_bytes")
  transferSyntax    String?  @map("transfer_syntax")
  reportId          String?  @map("report_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([studyInstanceUid])
  @@index([reportId])
  @@map("dicom_instances")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  severity  String    @default("INFO")
  title     String
  content   String
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime? @map("read_at")
  targetId  String?  @map("target_id")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  resource  String
  resourceId String? @map("resource_id")
  detail    Json?
  ip        String?
  userAgent String?  @map("user_agent")
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([action, resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model ExportApproval {
  id          String   @id @default(cuid())
  requesterId String   @map("requester_id")
  resource    String
  resourceId  String?  @map("resource_id")
  reason      String
  status      String   @default("PENDING")
  approverId  String?  @map("approver_id")
  approvedAt  DateTime? @map("approved_at")
  rejectReason String? @map("reject_reason")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([requesterId, status])
  @@index([status, createdAt])
  @@map("export_approvals")
}

model BackupRecord {
  id         String   @id @default(cuid())
  type       String
  filePath   String?  @map("file_path")
  sizeBytes  Int?     @map("size_bytes")
  status     String   @default("COMPLETED")
  checksum   String?
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@map("backup_records")
}

// v3.0.4 新增: Eye 模块

model EyeStudy {
  id          String   @id @default(cuid())
  patientId   String   @map("patient_id")
  modality    String
  bodyPart    String   @map("body_part")
  studyDate   DateTime @default(now()) @map("study_date")
  status      String   @default("PENDING")
  findings    String   @default("")
  impressions String   @default("")
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  inferences  EyeAiInference[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([patientId, modality])
  @@map("eye_studies")
}

model EyeAiInference {
  id         String   @id @default(cuid())
  studyId    String   @map("study_id")
  modelId    String   @map("model_id")
  diagnosis  String
  confidence Float
  heatmapUrl String?  @map("heatmap_url")
  study      EyeStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([studyId])
  @@index([modelId])
  @@map("eye_ai_inferences")
}

model EyeIolLens {
  id           String   @id @default(cuid())
  model        String
  manufacturer String
  aConstant    Float    @map("a_constant")
  power        Float
  type         String
  stock        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("eye_iol_lenses")
}

// v3.0.3 新增: 安全/不良事件模块

model AdverseEvent {
  id                 String                @id @default(cuid())
  eventType          AdverseEventType      @map("event_type")
  severity           AdverseEventSeverity
  description        String
  department         String
  reportedBy         String                @map("reported_by")
  reportedAt         DateTime              @default(now()) @map("reported_at")
  status             AdverseEventStatus    @default(REPORTED)
  patientId          String?               @map("patient_id")
  patientName        String?               @map("patient_name")
  location           String                @default("")
  contributingFactors String[]             @map("contributing_factors")
  actionsTaken       String[]              @map("actions_taken")
  rootCauseIds       String[]              @map("root_cause_ids")
  resolvedAt         DateTime?             @map("resolved_at")
  resolvedBy         String?               @map("resolved_by")
  closedAt           DateTime?             @map("closed_at")
  closedBy           String?               @map("closed_by")
  version            Int                   @default(0)
  rcaInvestigations  RcaInvestigation[]
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([status, severity])
  @@index([eventType, reportedAt])
  @@map("adverse_events")
}

model RcaInvestigation {
  id                    String        @id @default(cuid())
  adverseEventId        String        @map("adverse_event_id")
  eventTitle            String        @map("event_title")
  description           String        @default("")
  dateOccurred          DateTime      @map("date_occurred")
  dateInvestigationStarted DateTime    @default(now()) @map("date_investigation_started")
  teamMembers           String[]      @map("team_members")
  fishboneData          Json          @default("[]") @map("fishbone_data")
  fiveWhys              Json          @default("[]") @map("five_whys")
  rootCauses            String[]      @map("root_causes")
  capaPlans             Json          @default("[]") @map("capa_plans")
  capaStatus            String        @default("open") @map("capa_status")
  conclusion            String?
  lessonsLearned        String?       @map("lessons_learned")
  closedAt              DateTime?     @map("closed_at")
  closedBy              String?       @map("closed_by")
  version               Int           @default(0)
  adverseEvent          AdverseEvent  @relation(fields: [adverseEventId], references: [id], onDelete: Cascade)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([adverseEventId])
  @@index([capaStatus])
  @@map("rca_investigations")
}

model RiskItem {
  id                String    @id @default(cuid())
  riskType          String    @map("risk_type")
  title             String
  category          String
  description       String
  likelihood        Int
  severity          Int
  rpn               Int
  riskLevel         String    @map("risk_level")
  status            String    @default("open")
  identifiedBy      String    @map("identified_by")
  identifiedAt      DateTime  @default(now()) @map("identified_at")
  mitigationPlan    String?   @map("mitigation_plan")
  mitigationOwner   String?   @map("mitigation_owner")
  mitigationDeadline String?  @map("mitigation_deadline")
  residualRpn       Int?      @map("residual_rpn")
  closedAt          DateTime? @map("closed_at")
  closedBy          String?   @map("closed_by")
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([riskLevel, status])
  @@index([category])
  @@map("risk_items")
}

// v3.0.6.11-7: 牙科模块

model DentalStudy {
  id          String   @id @default(cuid())
  patientId   String   @map("patient_id")
  modality    String
  toothArea   String   @map("tooth_area")
  toothNumber String?  @map("tooth_number")
  studyDate   DateTime @default(now()) @map("study_date")
  status      String   @default("PENDING")
  findings    String   @default("")
  impressions String   @default("")
  aiFindings  DentalAiFinding[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([patientId, modality])
  @@map("dental_studies")
}

model DentalAiFinding {
  id           String   @id @default(cuid())
  studyId      String   @map("study_id")
  modelId      String   @map("model_id")
  findingType  String   @map("finding_type")
  findingDesc  String   @map("finding_desc")
  confidence   Float
  region       String?
  study        DentalStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([studyId])
  @@index([modelId])
  @@map("dental_ai_findings")
}

model DentalImplant {
  id            String   @id @default(cuid())
  patientId     String   @map("patient_id")
  toothNumber   String   @map("tooth_number")
  implantBrand  String   @map("implant_brand")
  implantModel  String   @map("implant_model")
  diameter      Float
  length        Float
  status        String   @default("PLANNED")
  surgeryDate   DateTime? @map("surgery_date")
  notes         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([patientId])
  @@map("dental_implants")
}

model DentalAppointment {
  id          String   @id @default(cuid())
  patientId   String   @map("patient_id")
  dentistName String   @map("dentist_name")
  modality    String
  scheduledAt DateTime @map("scheduled_at")
  state       String   @default("SCHEDULED")
  notes       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([scheduledAt, state])
  @@map("dental_appointments")
}

model DentalInvoice {
  id             String   @id @default(cuid())
  patientId      String   @map("patient_id")
  invoiceNumber  String   @unique @map("invoice_number")
  totalAmount    Decimal  @map("total_amount")
  paidAmount     Decimal  @default(0) @map("paid_amount")
  status         String   @default("UNPAID")
  items          Json     @default("[]")
  issuedAt       DateTime @default(now()) @map("issued_at")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([patientId, status])
  @@map("dental_invoices")
}

model DentalInventoryItem {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String
  quantity    Int      @default(0)
  unit        String
  unitPrice   Decimal  @map("unit_price")
  supplier    String?
  expiryDate  DateTime? @map("expiry_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("dental_inventory_items")
}

// v3.0.6.11-7: 工作流&SLA/路由模块

model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  stepConfig  Json     @default("[]") @map("step_config")
  version     Int      @default(1)
  active      Boolean  @default(true)
  steps       WorkflowStep[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("workflow_definitions")
}

model WorkflowStep {
  id                 String   @id @default(cuid())
  workflowId         String   @map("workflow_id")
  name               String
  stepType           String   @map("step_type")
  assigneeRole       String?  @map("assignee_role")
  timeoutMinutes     Int?     @map("timeout_minutes")
  escalationRole     String?  @map("escalation_role")
  config             Json     @default("{}")
  orderIndex         Int      @map("order_index")
  workflow           WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([workflowId, orderIndex])
  @@map("workflow_steps")
}

model SlaPolicy {
  id              String   @id @default(cuid())
  name            String
  modality        String?
  priority        String   @default("NORMAL")
  targetMinutes   Int      @map("target_minutes")
  warningMinutes  Int      @map("warning_minutes")
  escalationRole  String?  @map("escalation_role")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([modality, priority])
  @@map("sla_policies")
}

model RoutingRule {
  id              String   @id @default(cuid())
  name            String
  modality        String?
  bodyPart        String?  @map("body_part")
  sourceDept      String?  @map("source_dept")
  targetDept      String   @map("target_dept")
  priority        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([modality, bodyPart])
  @@map("routing_rules")
}

// v3.0.6.11-7: 财务模块

model ChargeItem {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String
  unitPrice   Decimal  @map("unit_price")
  insuranceCoverage Decimal? @map("insurance_coverage")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("charge_items")
}

model Invoice {
  id             String   @id @default(cuid())
  patientId      String   @map("patient_id")
  invoiceNumber  String   @unique @map("invoice_number")
  totalAmount    Decimal  @map("total_amount")
  paidAmount     Decimal  @default(0) @map("paid_amount")
  insuranceAmount Decimal? @map("insurance_amount")
  status         String   @default("UNPAID")
  items          Json     @default("[]")
  issuedAt       DateTime @default(now()) @map("issued_at")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([patientId, status])
  @@index([issuedAt])
  @@map("invoices")
}

// v3.0.6.11-8: HL7 消息归档
model Hl7MessageArchive {
  id          String   @id @default(cuid())
  messageType String   @map("message_type")
  controlId   String   @map("control_id")
  rawMessage  String   @map("raw_message")
  parsed      Json     @default("{}")
  direction   String   @default("INBOUND")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([messageType, createdAt])
  @@index([controlId])
  @@map("hl7_message_archives")
}

// v3.0.6.11-7: 通知模板/渠道

model NotificationTemplate {
  id        String   @id @default(cuid())
  type      String
  title     String
  content   String
  channel   String   @default("SYSTEM")
  variables String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, channel])
  @@map("notification_templates")
}

model NotificationChannel {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  config    Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_channels")
}
