// G005 放射RIS系统 v3.0.2.2 - Prisma Schema
// v3.0.1:5 个核心 model + 12 枚举
// v3.0.2 增量:CriticalValueNotification / ReportTemplate / ReportAuditEvent
// v3.0.2.2 增量:ReportQualityScore / DicomInstance / Notification
// v3.0.4: 增加 cuid() 默认值、FK 级联、AdverseEvent 枚举、version 乐观锁

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DOCTOR
  TECHNICIAN
  NURSE
  ADMIN
  DIRECTOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ReportState {
  PENDING_ASSIGNMENT
  ASSIGNED
  WRITING
  SUBMITTED
  INITIAL_REVIEW
  FINAL_REVIEW
  CO_SIGN_REVIEW
  REVIEWED
  SIGNING
  SIGNED
  PUBLISHED
  AMENDING
  AMENDED
  WITHDRAWN
  REJECTED
  ESCALATED
  ARCHIVED
  RECTIFYING
  SUPPLEMENTING
  SUPPLEMENTED
  REDISTRIBUTING
}

enum DeviceState {
  IDLE
  IN_USE
  MAINTENANCE
  BROKEN
  OFFLINE
}

enum CriticalState {
  FOUND
  NOTIFIED
  VOICE_CALLED
  ACKNOWLEDGED
  RECEIPTED
  RESOLVING
  RESOLVED
  CLOSED_LOOP
  ESCALATED
  CANCELLED
}

enum CriticalSeverity {
  LOW
  HIGH
  URGENT
  CRITICAL
}

enum NotificationMethod {
  PHONE
  SMS
  SYSTEM
  EMAIL
  WECHAT
  DINGTALK
}

enum PatientType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  PHYSICAL
}

enum AppointmentState {
  SCHEDULED
  CONFIRMED
  REGISTERED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentPriority {
  ROUTINE
  URGENT
  STAT
}

enum RadsCategory {
  BI_RADS
  LI_RADS
  PI_RADS
  TI_RADS
  CAD_RADS
  C_RADS
  O_RADS
  NI_RADS
}

enum WorklistOpType {
  ASSIGN
  REASSIGN
  START
  COMPLETE
  CANCEL
  PRINT
  EXPORT
}

enum AdverseEventType {
  MEDICATION_ERROR
  PATIENT_IDENTIFICATION
  CONTRAST_REACTION
  RADIATION_OVERDOSE
  FALL
  SPECIMEN_ERROR
  COMMUNICATION_FAILURE
  EQUIPMENT_MALFUNCTION
  INFORMATION_LOSS
  OTHER
}

enum AdverseEventSeverity {
  NEAR_MISS
  MINOR
  MODERATE
  SEVERE
  CATASTROPHIC
}

enum AdverseEventStatus {
  REPORTED
  INVESTIGATING
  RESOLVED
  CLOSED
}

model User {
  id                  String         @id @default(cuid())
  tenantId            String         @map("tenant_id")
  username            String         @unique
  passwordHash        String         @map("password_hash")
  fullName            String         @map("full_name")
  role                UserRole
  department          String?
  active              Boolean        @default(true)
  totpSecret          String?        @map("totp_secret")
  totpEnabled         Boolean        @default(false) @map("totp_enabled")
  failedLoginAttempts Int            @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?      @map("locked_until")
  tokenVersion        Int            @default(0) @map("token_version")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  reports             Report[]       @relation("ReportRadiologist")
  opsLog              WorklistOp[]
  loginLogs           LoginLog[]
  Notification        Notification[]
  NotificationSubscription NotificationSubscription[]

  @@index([tenantId])
  @@map("users")
}

model Patient {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  name          String
  gender        Gender
  birthDate     DateTime?     @map("birth_date")
  idCard        String?       @unique @map("id_card")
  phone         String?
  type          PatientType   @default(OUTPATIENT)
  state         String        @default("registered")
  deletedAt     DateTime?     @map("deleted_at")
  reports       Report[]
  exams         Exam[]
  appointments  Appointment[]
  studies       EyeStudy[]
  criticalValues CriticalValue[]
  version       Int           @default(0)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([name, phone])
  @@index([tenantId])
  @@map("patients")
}

model Exam {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  patientId       String    @map("patient_id")
  accessionNumber String    @unique @map("accession_number")
  modality        String
  bodyPart        String    @map("body_part")
  scheduledAt     DateTime? @map("scheduled_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  deviceId        String?   @map("device_id")
  state           String    @default("SCHEDULED")
  version         Int       @default(0)
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  device          Device?   @relation(fields: [deviceId], references: [id])
  reports         Report[]
  criticalValues  CriticalValue[]
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([patientId, modality])
  @@index([tenantId])
  @@index([tenantId, state])
  @@index([tenantId, createdAt])
  @@index([tenantId, scheduledAt])
  @@map("exams")
}

model Report {
  id                 String               @id @default(cuid())
  tenantId           String               @map("tenant_id")
  patientId          String               @map("patient_id")
  examId             String?              @map("exam_id")
  radiologistId      String?              @map("radiologist_id")
  state              ReportState          @default(PENDING_ASSIGNMENT)
  findings           String               @default("")
  diagnosis          String               @default("")
  impression         String               @default("")
  recommendations    String               @default("")
  conclusion         String               @default("")
  signedAt           DateTime?            @map("signed_at")
  signedById         String?              @map("signed_by_id")
  rejectReason       String?              @map("reject_reason")
  reviewedAt         DateTime?            @map("reviewed_at")
  publishedAt        DateTime?            @map("published_at")
  reviewerId         String?              @map("reviewer_id")
  coSignerId         String?              @map("co_signer_id")
  coSignedAt         DateTime?            @map("co_signed_at")
  amendmentReason    String?              @map("amendment_reason")
  rectificationCount Int                  @default(0) @map("rectification_count")
  supplementCount    Int                  @default(0) @map("supplement_count")
  isCritical         Boolean              @default(false) @map("is_critical")
  qualityScore       Int?                 @map("quality_score")
  version            Int                  @default(0)
  patient            Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  exam               Exam?                @relation(fields: [examId], references: [id], onDelete: SetNull)
  radiologist        User?                @relation("ReportRadiologist", fields: [radiologistId], references: [id], onDelete: SetNull)
  revisions          ReportRevision[]
  radPathRecords     RadPathRecord[]
  srDocuments        SrDocument[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  ReportQualityScore ReportQualityScore[]
  DicomInstance      DicomInstance[]

  @@index([state, patientId])
  @@index([radiologistId])
  @@index([tenantId])
  @@index([tenantId, state])
  @@index([tenantId, radiologistId])
  @@index([tenantId, signedAt])
  @@map("reports")
}

model ReportRevision {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  reportId  String      @map("report_id")
  actorId   String      @map("actor_id")
  fromState ReportState @map("from_state")
  toState   ReportState @map("to_state")
  reason    String?
  report    Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([reportId, createdAt])
  @@index([tenantId])
  @@map("report_revisions")
}

model Device {
  id            String      @id @default(cuid())
  tenantId      String      @map("tenant_id")
  code          String      @unique
  name          String
  modality      String
  manufacturer  String?
  location      String?
  state         DeviceState @default(IDLE)
  todayExams    Int         @default(0) @map("today_exams")
  todayUsageMin Int         @default(0) @map("today_usage_min")
  version       Int         @default(0)
  exams         Exam[]
  appointments  Appointment[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("devices")
}

model CriticalValue {
  id                        String                      @id @default(cuid())
  tenantId                  String                      @map("tenant_id")
  examId                    String?                     @map("exam_id")
  patientId                 String?                     @map("patient_id")
  description               String
  severity                  CriticalSeverity            @default(HIGH)
  state                     CriticalState               @default(FOUND)
  method                    NotificationMethod          @default(SYSTEM)
  notifiedTo                String?                     @map("notified_to")
  voiceCalledAt             DateTime?                   @map("voice_called_at")
  voiceCalledBy             String?                     @map("voice_called_by")
  ackedBy                   String?                     @map("acked_by")
  ackedAt                   DateTime?                   @map("acked_at")
  confirmedBy               String?                     @map("confirmed_by")
  confirmedAt               DateTime?                   @map("confirmed_at")
  confirmedSignature        String?                     @map("confirmed_signature")
  confirmedComment          String?                     @map("confirmed_comment")
  resolvedBy                String?                     @map("resolved_by")
  resolvedAt                DateTime?                   @map("resolved_at")
  closedBy                  String?                     @map("closed_by")
  closedAt                  DateTime?                   @map("closed_at")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  exam                      Exam?                       @relation(fields: [examId], references: [id], onDelete: SetNull)
  patient                   Patient?                    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  CriticalValueNotification CriticalValueNotification[]

  @@index([state, severity])
  @@index([tenantId])
  @@index([patientId])
  @@map("critical_values")
}

model Appointment {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  patientId   String              @map("patient_id")
  deviceId    String?             @map("device_id")
  modality    String
  patientName String              @default("") @map("patient_name")
  bodyPart    String?             @map("body_part")
  scheduledAt DateTime            @map("scheduled_at")
  endAt       DateTime?           @map("end_at")
  priority    AppointmentPriority @default(ROUTINE)
  createdById String?             @map("created_by_id")
  state       AppointmentState    @default(SCHEDULED)
  version     Int                 @default(0)
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  device      Device?             @relation(fields: [deviceId], references: [id])
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([patientId])
  @@index([scheduledAt, state])
  @@index([deviceId, scheduledAt])
  @@index([tenantId])
  @@map("appointments")
}

model RadsTemplate {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  category  RadsCategory
  code      String
  name      String
  body      String
  parentId  String?      @map("parent_id")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([category, code])
  @@index([tenantId])
  @@map("rads_templates")
}

model WorklistOp {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  actorId   String         @map("actor_id")
  op        WorklistOpType
  examId    String?        @map("exam_id")
  payload   Json?
  actor     User           @relation(fields: [actorId], references: [id])
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([tenantId])
  @@map("worklist_ops")
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// v3.0.6.11-60: 多租户 SaaS 基础 - 租户档案 (对标 Sectra One Cloud / Philips HealthSuite)
// features Json: { aiOrchestration: bool, biDashboard: bool, doseManagement: bool,
//                 vna: bool, similarCases: bool, environmentReport: bool,
//                 mobileApp: bool, teleRadiology: bool }
// config Json:  { locale, timezone, branding, contactEmail, notificationChannels }
model Tenant {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  status         String   @default("ACTIVE") // ACTIVE | DISABLED
  license        String   @default("Enterprise")
  maxUsers       Int      @default(200)
  maxStorageGb   Int      @default(1024)
  maxExams       Int      @default(100000)
  features       Json     @default("{}")
  config         Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("tenants")
}

model LoginLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  ip        String
  userAgent String?  @map("user_agent")
  success   Boolean
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([tenantId])
  @@map("login_logs")
}

// v3.0.2 新增:CriticalValueNotification / ReportTemplate / ReportAuditEvent
// (Appointment / AppointmentState 在 v3.0.1 已存在,无需重复)

model CriticalValueNotification {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  criticalId     String        @map("critical_id")
  critical       CriticalValue @relation(fields: [criticalId], references: [id], onDelete: Cascade)
  patientName    String        @map("patient_name")
  patientId      String        @map("patient_id")
  category       String
  finding        String
  channel        String
  recipientName  String        @map("recipient_name")
  recipientDept  String        @map("recipient_dept")
  recipientPhone String        @map("recipient_phone")
  status         String
  ackerName      String?       @map("acker_name")
  ackedAt        DateTime?     @map("acked_at")
  escalated      Boolean       @default(false)
  triggeredAt    DateTime      @map("triggered_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([criticalId])
  @@index([status, triggeredAt])
  @@index([tenantId])
  @@map("critical_notifications")
}

model ReportTemplate {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  category     String
  bodyPart     String   @map("body_part")
  body         String
  parentId     String?  @map("parent_id")
  version      Int      @default(1)
  radsCategory String?  @map("rads_category")
  tags         String[]
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category, bodyPart])
  @@index([tenantId])
  @@map("report_templates")
}

model ReportAuditEvent {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  reportId    String   @map("report_id")
  actor       String
  actorRole   String   @map("actor_role")
  action      String
  description String
  detail      Json?
  prevHash    String   @map("prev_hash")
  hash        String
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([reportId, createdAt])
  @@index([tenantId])
  @@map("report_audit_events")
}

// v3.0.2.2 新增:ReportQualityScore + DicomInstance + Notification

model ReportQualityScore {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  reportId    String   @map("report_id")
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  totalScore  Int      @map("total_score")
  grade       String
  dimensions  Json
  suggestions String[]
  evaluatedAt DateTime @map("evaluated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([reportId, evaluatedAt])
  @@index([tenantId])
  @@map("report_quality_scores")
}

model DicomInstance {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  studyInstanceUid  String   @map("study_instance_uid")
  seriesInstanceUid String   @map("series_instance_uid")
  sopInstanceUid    String   @unique @map("sop_instance_uid")
  sopClassUid       String   @map("sop_class_uid")
  modality          String
  storagePath       String?  @map("storage_path")
  sizeBytes         Int?     @map("size_bytes")
  transferSyntax    String?  @map("transfer_syntax")
  reportId          String?  @map("report_id")
  report            Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([studyInstanceUid])
  @@index([reportId])
  @@index([tenantId])
  @@index([modality])
  @@index([tenantId, modality])
  @@map("dicom_instances")
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  severity  String    @default("INFO")
  title     String
  content   String
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime? @map("read_at")
  targetId  String?   @map("target_id")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, read, createdAt])
  @@index([tenantId])
  @@map("notifications")
}

model NotificationSubscription {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keysJson  String   @map("keys_json")
  topics    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tenantId])
  @@map("notification_subscriptions")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  detail     Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  success    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([action, resource])
  @@index([createdAt])
  @@index([tenantId])
  @@map("audit_logs")
}

model ExportApproval {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  requesterId  String    @map("requester_id")
  resource     String
  resourceId   String?   @map("resource_id")
  reason       String
  status       String    @default("PENDING")
  approverId   String?   @map("approver_id")
  approvedAt   DateTime? @map("approved_at")
  rejectReason String?   @map("reject_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([requesterId, status])
  @@index([status, createdAt])
  @@index([tenantId])
  @@map("export_approvals")
}

model BackupRecord {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  type      String
  filePath  String?  @map("file_path")
  sizeBytes Int?     @map("size_bytes")
  status    String   @default("COMPLETED")
  checksum  String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([tenantId])
  @@map("backup_records")
}

// v3.0.4 新增: Eye 模块

model EyeStudy {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  patientId   String           @map("patient_id")
  modality    String
  bodyPart    String           @map("body_part")
  studyDate   DateTime         @default(now()) @map("study_date")
  status      String           @default("PENDING")
  findings    String           @default("")
  impressions String           @default("")
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  inferences  EyeAiInference[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([patientId, modality])
  @@index([tenantId])
  @@map("eye_studies")
}

model EyeAiInference {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  studyId    String   @map("study_id")
  modelId    String   @map("model_id")
  diagnosis  String
  confidence Float
  heatmapUrl String?  @map("heatmap_url")
  study      EyeStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([studyId])
  @@index([modelId])
  @@index([tenantId])
  @@map("eye_ai_inferences")
}

model EyeIolLens {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  model        String
  manufacturer String
  aConstant    Float    @map("a_constant")
  power        Float
  type         String
  stock        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("eye_iol_lenses")
}

// v3.0.6.11-10: PIX external ID mapping + Visit model
model PatientExternalId {
  id                 String @id @default(cuid())
  tenantId           String @map("tenant_id")
  assigningAuthority String @map("assigning_authority")
  externalId         String @map("external_id")
  internalPatientId  String @map("internal_patient_id")

  @@unique([assigningAuthority, externalId])
  @@index([internalPatientId])
  @@index([tenantId])
  @@map("patient_external_ids")
}

model PatientVisit {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  patientId         String    @map("patient_id")
  visitNumber       String    @map("visit_number")
  status            String    @default("registered")
  classCode         String?   @map("class_code")
  assignedLocation  Json?     @map("assigned_location")
  admitDateTime     DateTime? @map("admit_date_time")
  dischargeDateTime DateTime? @map("discharge_date_time")
  inProgressAt      DateTime? @map("in_progress_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([patientId, visitNumber])
  @@index([patientId, status])
  @@index([tenantId])
  @@map("patient_visits")
}

// v3.0.3 新增: 安全/不良事件模块

model AdverseEvent {
  id                  String               @id @default(cuid())
  tenantId            String               @map("tenant_id")
  eventType           AdverseEventType     @map("event_type")
  severity            AdverseEventSeverity
  description         String
  department          String
  reportedBy          String               @map("reported_by")
  reportedAt          DateTime             @default(now()) @map("reported_at")
  status              AdverseEventStatus   @default(REPORTED)
  patientId           String?              @map("patient_id")
  patientName         String?              @map("patient_name")
  location            String               @default("")
  contributingFactors String[]             @map("contributing_factors")
  actionsTaken        String[]             @map("actions_taken")
