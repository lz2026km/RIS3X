# G005 Backend v3.0.1
DATABASE_URL="postgresql://g005:g005@localhost:5432/g005?schema=public"
JWT_SECRET="g005-dev-secret-change-in-prod"
PORT=3001
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGINS="http://localhost:5191,http://localhost:4173"
SENTRY_DSN=""
GENERATE_OPENAPI=false

# Cache / Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# HL7 MLLP
HL7_MLLP_PORT=2575
HL7_MLLP_RETRY_MAX=3
HL7_MLLP_RETRY_INTERVAL=5000
HL7_MLLP_TIMEOUT=10000
HL7_MLLP_WHITELIST=""
HL7_MLLP_TLS_ENABLED=false
HL7_PUSH_ENABLED=false
HL7_PUSH_HOST=""
HL7_PUSH_PORT=2575

# FHIR
FHIR_BASE_URL=http://localhost:3001/api/fhir/r4
SMART_AUTH_URL=http://localhost:3001/api/fhir/r4
FHIR_SUBSCRIPTION_HMAC_SECRET="change-in-prod"

# AI / DeepSeek
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Storage
BACKUP_DIR=/data/backups
TEACH_BLOB_DIR=/data/teach
