# G005 Backend 3.0.6.11-70
# 必填: 部署前必须填写 ★
DATABASE_URL="postgresql://g005:g005@localhost:5432/g005?schema=public"
JWT_SECRET=""                                        # ★ 必填, 至少 32 字符 (openssl rand -base64 32)
PORT=3001
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:5191,http://localhost:4173"
CSRF_SECRET=""                                       # 生产至少 32 字符；为空时回退 JWT_SECRET
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
TRUST_PROXY=""                                       # 仅在可信反向代理后配置
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
GENERATE_OPENAPI=false

# 默认租户 (多租户系统默认 tenant_id)
DEFAULT_TENANT_ID=default

# Cache / Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""                                    # 生产必填
REDIS_DB=0
REDIS_TLS=false

# HL7 MLLP
HL7_MLLP_PORT=2575
HL7_MLLP_RETRY_MAX=3
HL7_MLLP_RETRY_INTERVAL=5000
HL7_MLLP_TIMEOUT=10000
HL7_MLLP_WHITELIST=""
HL7_MLLP_TLS_ENABLED=false
HL7_MLLP_TLS_KEY=""                                  # TLS 启用时必填, 证书绝对路径
HL7_MLLP_TLS_CERT=""                                 # TLS 启用时必填, 证书绝对路径
HL7_PUSH_ENABLED=false
HL7_PUSH_HOST=""
HL7_PUSH_PORT=2575

# FHIR
FHIR_BASE_URL=http://localhost:3001/api/fhir/r4
SMART_AUTH_URL=http://localhost:3001/api/fhir/r4
FHIR_SUBSCRIPTION_HMAC_SECRET=""                     # ★ 必填 (openssl rand -base64 48)

# IHE / DICOM DIMSE
IHE_DOMAIN_NAME=Handong-Provincial-Hospital
DIMSE_DEFAULT_HOST=127.0.0.1
DIMSE_DEFAULT_PORT=11112
DIMSE_AE_MAPPING=""                                  # 格式: AE1,host1,port1;AE2,host2,port2

# DICOM 窗位/窗框预设 (Fusion 模块 zod 默认值同步)
DICOM_WINDOW_WIDTH_LUNG=1200
DICOM_WINDOW_LEVEL_LUNG=-600
DICOM_WINDOW_WIDTH_MEDIASTINAL=400
DICOM_WINDOW_LEVEL_MEDIASTINAL=40
DICOM_WINDOW_WIDTH_BONE=2000
DICOM_WINDOW_LEVEL_BONE=300
DICOM_WINDOW_WIDTH_BRAIN=80
DICOM_WINDOW_LEVEL_BRAIN=40
DICOM_WINDOW_WIDTH_ABDOMEN=350
DICOM_WINDOW_LEVEL_ABDOMEN=50

# AI / DeepSeek
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ASR 语音识别 (Phase 1.4): 配置后走外部 Whisper 兼容 API, 未配置回退确定性模拟转写
ASR_API_KEY=""                                        # 外部 ASR 服务 Bearer Key
WHISPER_API_URL=""                                    # 例: https://api.openai.com/v1/audio/transcriptions
ASR_MODEL=whisper-1

# Storage (Windows 示例: C:/data/backups, Linux 保持 /data/backups)
BACKUP_DIR=/data/backups
TEACH_BLOB_DIR=/data/teach

# ── 存储抽象层 (Storage Abstraction) v3.0.6.11-70 ──
# STORAGE_DRIVER: local | s3 (未设置时默认 local, 行为与旧版本一致)
#   - local: DICOM 存 DICOM_STORAGE_DIR, VNA 存 VNA_STORAGE_DIR, Files 存 FILES_STORAGE_DIR
#   - s3:    所有 DICOM/VNA/Files 对象写入 S3/MinIO (AWS SigV4, 无需 AWS SDK)
# 未设置 STORAGE_DRIVER 时, 运行时会读取 SystemConfig 表 (storage_config key, 由
# /api/system/storage-config 页面保存), 仍未配置则回退 local。
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000                          # MinIO 默认端口
S3_BUCKET=g005                                             # 需预先创建
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# DICOM_STORAGE_DIR / VNA_STORAGE_DIR / FILES_STORAGE_DIR 仅在 local 驱动下生效