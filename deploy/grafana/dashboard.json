{
  "__inputs": [],
  "__requires": [],
  "title": "G005 RIS - 系统监控",
  "uid": "g005-ris-system",
  "version": 2,
  "timezone": "browser",
  "panels": [
    {
      "title": "API 错误率",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{job=\"g005-ris\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"g005-ris\"}[5m]))) * 100",
          "legendFormat": "错误率 %"
        }
      ]
    },
    {
      "title": "P99 延迟",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"g005-ris\"}[5m]))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "title": "请求速率",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"g005-ris\"}[5m]))",
          "legendFormat": "请求/s"
        }
      ]
    },
    {
      "title": "队列积压",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(queue_jobs_waiting{job=\"g005-ris\"})",
          "legendFormat": "等待"
        },
        {
          "expr": "sum(queue_jobs_active{job=\"g005-ris\"})",
          "legendFormat": "活跃"
        }
      ]
    },
    {
      "title": "队列失败任务",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 6 },
      "targets": [
        {
          "expr": "rate(queue_jobs_failed_total{job=\"g005-ris\"}[5m])",
          "legendFormat": "失败/s"
        }
      ]
    },
    {
      "title": "缓存命中率",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "targets": [
        {
          "expr": "rate(cache_hits_total{job=\"g005-ris\"}[5m]) / (rate(cache_hits_total{job=\"g005-ris\"}[5m]) + rate(cache_misses_total{job=\"g005-ris\"}[5m])) * 100",
          "legendFormat": "命中率 %"
        }
      ]
    },
    {
      "title": "数据库活跃连接",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "db_active_connections{job=\"g005-ris\"}",
          "legendFormat": "活跃连接"
        }
      ]
    },
    {
      "title": "数据库连接错误",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "rate(db_connection_errors_total{job=\"g005-ris\"}[5m])",
          "legendFormat": "错误/s"
        }
      ]
    },
    {
      "title": "Pod 重启次数",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(kube_pod_container_status_restarts_total{namespace=~\"g005-ris\"}[5m]))",
          "legendFormat": "重启/s"
        }
      ]
    },
    {
      "title": "磁盘使用率",
      "type": "graph",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "(1 - node_filesystem_avail_bytes{fstype!=\"\"} / node_filesystem_size_bytes{fstype!=\"\"}) * 100",
          "legendFormat": "{{ instance }}"
        }
      ]
    }
  ],
  "tags": ["g005", "ris", "monitoring"],
  "schemaVersion": 27
}
